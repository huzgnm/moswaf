# ==========================================================
# MosWAF deployment configuration
# The file actually used is .env (install.sh generates it)
# ==========================================================

MOSWAF_VERSION=0.1.0

# --- Data plane ports (real visitor traffic) ---
MOSWAF_HTTP_PORT=80
MOSWAF_HTTPS_PORT=443

# --- The admin dashboard's OWN port (never shared with traffic) ---
MOSWAF_ADMIN_PORT=9443

# Bind the dashboard to this address. 0.0.0.0 exposes it to the internet,
# 127.0.0.1 makes it reachable only through an SSH tunnel (the safest option).
MOSWAF_ADMIN_BIND=0.0.0.0

# --- Initial admin account (only used on the very first boot) ---
MOSWAF_ADMIN_USER=admin
MOSWAF_ADMIN_PASSWORD=

# --- Postgres ---
POSTGRES_USER=moswaf
POSTGRES_PASSWORD=
POSTGRES_DB=moswaf

# --- Redis (config sync channel and log queue between the two planes) ---
REDIS_PASSWORD=

# --- Secrets signing the session JWT and the challenge cookie ---
# Leave these empty and the control plane refuses to start. Generate them with:
#   openssl rand -hex 32
# A known JWT secret hands over the dashboard; a known challenge secret lets anyone
# forge the cookie and walk past the JS challenge.
MOSWAF_JWT_SECRET=
MOSWAF_CHALLENGE_SECRET=

# --- Shared secret for the internal API between the two planes ---
# The data plane's API on port 8081 is reachable from anything on the same Docker
# network. This token is what separates the control plane from a neighbouring
# container that would otherwise be able to lift bans.
MOSWAF_INTERNAL_TOKEN=

# --- Where data is stored on the host ---
MOSWAF_DATA_DIR=./data

# --- Data plane log level: debug|info|notice|warn|error ---
MOSWAF_LOG_LEVEL=warn

# --- ACME directory for automatic certificates ---
# Empty means Let's Encrypt production. Point it at
#   https://acme-staging-v02.api.letsencrypt.org/directory
# while testing: production rate limits are strict and a handful of failed attempts
# can lock a domain out for a week.
MOSWAF_ACME_DIRECTORY=

# --- Timezone shown on the dashboard ---
TZ=Asia/Ho_Chi_Minh
