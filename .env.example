# ==========================================================
# MosWAF - cau hinh trien khai
# File that su dung la .env (install.sh se tu sinh)
# ==========================================================

MOSWAF_VERSION=0.1.0

# --- Cong cua data plane (traffic that cua khach) ---
MOSWAF_HTTP_PORT=80
MOSWAF_HTTPS_PORT=443

# --- Cong RIENG cua dashboard admin (khong dung chung voi traffic) ---
MOSWAF_ADMIN_PORT=9443

# Chi bind dashboard vao IP nay. 0.0.0.0 = mo ra internet,
# 127.0.0.1 = chi vao duoc qua SSH tunnel (an toan nhat).
MOSWAF_ADMIN_BIND=0.0.0.0

# --- Tai khoan admin khoi tao (chi dung cho lan boot dau tien) ---
MOSWAF_ADMIN_USER=admin
MOSWAF_ADMIN_PASSWORD=changeme

# --- Postgres ---
POSTGRES_USER=moswaf
POSTGRES_PASSWORD=changeme
POSTGRES_DB=moswaf

# --- Redis (kenh dong bo config + hang doi log giua control plane va data plane) ---
REDIS_PASSWORD=changeme

# --- Bi mat ky JWT phien dang nhap va cookie challenge ---
MOSWAF_JWT_SECRET=changeme
MOSWAF_CHALLENGE_SECRET=changeme

# --- Thu muc luu du lieu tren host ---
MOSWAF_DATA_DIR=./data

# --- Muc do log cua data plane: debug|info|notice|warn|error ---
MOSWAF_LOG_LEVEL=warn

# --- Timezone hien thi tren dashboard ---
TZ=Asia/Ho_Chi_Minh
